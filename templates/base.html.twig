<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Comodo Booking{% endblock %}</title>

    {# Fonts #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500;600;700&family=Hero:wght@300;400;500;600&display=swap" rel="stylesheet">

    {# CSS compiled via Encore #}
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}

    {% block javascripts %}
    {{ encore_entry_script_tags('app') }}
    {% endblock %}
</head>
<body class="pattern-bg">
    <nav class="navbar">
        <div class="nav-container">
            <div class="nav-logo">
                <img src="{{ asset('images/Comodo Site Logo.png') }}" alt="Comodo Booking" class="logo-img">
            </div>
            <div class="nav-menu">
                <a href="#" class="nav-link">Services</a>
                <a href="#" class="nav-link">About</a>
                <a href="#" class="nav-link">FAQ</a>
                <div class="auth-buttons">
                    <a href="#" class="btn-signup">Sign Up</a>
                </div>
            </div>
        </div>
    </nav>

    <main class="main-content">
        {% block body %}{% endblock %}
    </main>

    <footer class="footer">
        <div class="footer-container">
            <p>&copy; {{ "now"|date("Y") }} Comodo Booking. All rights reserved.</p>
            <div class="footer-symbols">✦ ◊ ✦</div>
        </div>
    </footer>

    {# {% block javascripts %}{% endblock %} #}
</body>
</html>
