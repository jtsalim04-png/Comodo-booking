{% extends 'base.html.twig' %}

{% block title %}Comodo Booking{% endblock %}

{% block body %}
    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-container">
            <div class="hero-content">
                <h1 class="hero-title">Unveil the Future of Event Ticketing</h1>
                <p class="hero-subtitle">Where your ticketing needs bring you a magical experience</p>
                <p class="hero-description">
                    Comodo Booking provides a seamless digital ticketing platform for both organizers and attendees. 
                    Create events, sell tickets, and manage everything through our intuitive dashboard - all while 
                    earning rewards through our daily check-in system.
                </p>
                <div class="hero-buttons">
                    <a href="#" class="btn-primary">Start Your Journey</a>
                    <a href="#about" class="btn-secondary">Discover More</a>
                </div>
            </div>
            <div class="hero-visual">
                <div class="mystical-card">
                    <div class="card-inner">
                        <div class="card-symbols">✦</div>
                        <div class="card-title">Digital Tickets Placeholder</div>
                        <div class="card-symbols">◊</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="about">
        <div class="about-container">
            <div class="section-header">
                <h2 class="section-title">About Comodo Booking</h2>
                <div class="title-divider">✦ ◊ ✦</div>
            </div>
            
            <div class="about-grid">
                <div class="about-card">
                    <div class="card-icon">🎭</div>
                    <h3 class="card-title">For Organizers</h3>
                    <p class="card-description">
                        Create an account and list your events with ease. Set ticket prices, manage inventory, 
                        and track sales through our real-time dashboard. Watch your events come to life with 
                        detailed analytics and insights.
                    </p>
                </div>

                <div class="about-card">
                    <div class="card-icon">🎫</div>
                    <h3 class="card-title">For Attendees</h3>
                    <p class="card-description">
                        Browse upcoming events, purchase tickets, and select your perfect seats. Receive unique 
                        QR codes for secure entry and enjoy a seamless check-in experience at the venue.
                    </p>
                </div>

                <div class="about-card">
                    <div class="card-icon">⚡</div>
                    <h3 class="card-title">QR Code Validation</h3>
                    <p class="card-description">
                        Venue staff can quickly scan QR codes to validate tickets, ensuring a smooth and 
                        convenient check-in process. No more long queues or paper tickets to manage.
                    </p>
                </div>

                <div class="about-card">
                    <div class="card-icon">🏆</div>
                    <h3 class="card-title">Rewards System</h3>
                    <p class="card-description">
                        Earn points through daily check-ins and ticket purchases. Redeem your points for 
                        discount vouchers and unlock exclusive offers. The more you engage, the more you save.
                    </p>
                </div>
            </div>

            <div class="about-vision">
                <div class="vision-content">
                    <h3 class="vision-title">Our Mission</h3>
                    <p class="vision-text">
                        To simplify and modernize the way people
                        attend events by providing a seamless,
                        secure, and convenient ticketing experience
                        powered by smart QR technology.
                    </p>
                </div>
                <div class="vision-visual">
                    <div class="mystical-elements">
                        <div class="element">✦</div>
                        <div class="element">◊</div>
                        <div class="element">✧</div>
                    </div>
                </div>
            </div>


            <div class="about-vision">
                <div class="vision-content">
                    <h3 class="vision-title">Our Vision</h3>
                    <p class="vision-text">
                        To become a trusted leader in digital ticketing and
                        event access solutions, making every event more
                        organized, efficient, and enjoyable for organizers
                        and attendees alike.
                    </p>
                </div>
                <div class="vision-visual">
                    <div class="mystical-elements">
                        <div class="element">✧</div>
                        <div class="element">◊</div>
                        <div class="element">✦</div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
